#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)
REPO_ROOT="$SCRIPT_DIR"
CONFIG_DIR="$REPO_ROOT/config"
PROJECTS_DIR="$REPO_ROOT/projects"
PANDOC_ARGS_JSON="$CONFIG_DIR/pandoc-args.json"

shell_quote() {
    local value=$1
    printf "'%s'" "${value//\'/\'\"\'\"\'}"
}

find_docker_compose() {
    if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
        DOCKER_COMPOSE_CMD=(docker compose)
    elif command -v docker-compose >/dev/null 2>&1; then
        DOCKER_COMPOSE_CMD=(docker-compose)
    else
        echo "Error: neither 'docker compose' nor 'docker-compose' was found." >&2
        exit 1
    fi
}

ensure_tools() {
    command -v jq >/dev/null 2>&1 || {
        echo "Error: jq command not found." >&2
        exit 1
    }

    find_docker_compose
}

usage() {
    cat <<'EOF'
Pandocker-X

Usage:
  pdx setup
  pdx new <ProjectName> [-Paper]
  pdx build <ProjectName> [options]

Build options:
  -All    Build every Markdown file under the project source directory
  -Log    Save pandoc output to log/
EOF
}

print_version() {
    echo "Pandocker-X shell entrypoint 2.3.2-alpha"
}

setup_project() {
    ensure_tools

    cd "$REPO_ROOT"
    echo "[1/3] Building the Docker image..."
    "${DOCKER_COMPOSE_CMD[@]}" build

    echo "[2/3] Preparing the Docker volume..."
    "${DOCKER_COMPOSE_CMD[@]}" up -d --no-deps pandoc >/dev/null
    "${DOCKER_COMPOSE_CMD[@]}" stop pandoc >/dev/null

    echo "[3/3] Generating TeX Live formats..."
    "${DOCKER_COMPOSE_CMD[@]}" run --rm --entrypoint bash pandoc -lc 'fmtutil-sys --all'

    echo "=== Setup complete ==="
    echo "Run 'pdx new' and 'pdx build' from this repository."
}

new_project() {
    local report_name=""
    local paper=false

    for arg in "$@"; do
        if [[ "$arg" == "-Paper" ]]; then
            paper=true
        elif [[ -z "$report_name" ]]; then
            report_name="$arg"
        else
            echo "Error: unexpected argument '$arg'." >&2
            exit 1
        fi
    done

    if [[ -z "$report_name" ]]; then
        echo "Error: project name is required." >&2
        echo "Usage: pdx new <ProjectName> [-Paper]" >&2
        exit 1
    fi

    local projects_base="$PROJECTS_DIR"
    local target_dir="$projects_base/$report_name"
    local template_path="$REPO_ROOT/templates/report.md"
    local defaults_path="$REPO_ROOT/defaults.yml"
    if [[ "$paper" == true ]]; then
        defaults_path="$REPO_ROOT/defaults-paper.yml"
    fi

    mkdir -p "$projects_base"
    if [[ -e "$target_dir" ]]; then
        echo "Error: 'projects/$report_name' already exists." >&2
        exit 1
    fi

    echo "Creating 'projects/$report_name'..."
    mkdir -p "$target_dir/content" "$target_dir/images" "$target_dir/bib" "$target_dir/output"
    : > "$target_dir/bib/references.bib"

    local template_content
    local csl_path="/app/csl/ieee-with-url.csl"
    template_content=$(<"$template_path")
    template_content=${template_content//\{\{DATE\}\}/$(date +%F)}
    template_content=${template_content//\{\{CSL_PATH\}\}/$csl_path}
    printf '%s' "$template_content" > "$target_dir/content/report.md"

    if [[ -f "$defaults_path" ]]; then
        cp "$defaults_path" "$target_dir/defaults.yml"
    elif [[ "$paper" == true ]]; then
        echo "Error: paper preset '$defaults_path' was not found." >&2
        exit 1
    fi

    echo
    echo "Project 'projects/$report_name' is ready."
    echo "Edit projects/$report_name/content/report.md to start writing."
    if [[ "$paper" == true ]]; then
        echo "Paper preset enabled: defaults.yml was copied from defaults-paper.yml."
    fi
}

build_project() {
    local report_name=""
    local -a input_files=()
    local -a buildable_files=()
    local all=false
    local log=false
    local had_failure=false

    for arg in "$@"; do
        case "$arg" in
            -All)
                all=true
                ;;
            -Log)
                log=true
                ;;
            -*)
                echo "Error: unknown option $arg" >&2
                exit 1
                ;;
            *)
                if [[ -z "$report_name" ]]; then
                    report_name="$arg"
                else
                    input_files+=("$arg")
                fi
                ;;
        esac
    done

    if [[ -z "$report_name" ]]; then
        echo "Error: project name is required." >&2
        echo "Usage: pdx build <ProjectName> [options]" >&2
        exit 1
    fi

    local source_dir
    source_dir=$(resolve_project_source_dir "$report_name")
    if [[ "$all" == true ]]; then
        if [[ -d "$source_dir" ]]; then
            while IFS= read -r file; do
                input_files+=("${file#"$source_dir"/}")
            done < <(find "$source_dir" -type f -name '*.md' | sort)
        else
            echo "Warning: $source_dir not found." >&2
        fi
    elif [[ ${#input_files[@]} -eq 0 ]]; then
        input_files=("report.md")
    fi

    if [[ ${#input_files[@]} -eq 0 ]]; then
        echo "No Markdown files to build."
        exit 0
    fi

    local input_file host_input_path
    for input_file in "${input_files[@]}"; do
        host_input_path="$source_dir/$input_file"
        if [[ ! -f "$host_input_path" ]]; then
            echo "Warning: missing $host_input_path, skipping." >&2
            had_failure=true
            continue
        fi
        buildable_files+=("$input_file")
    done

    if [[ ${#buildable_files[@]} -eq 0 ]]; then
        if [[ "$had_failure" == true ]]; then
            echo "Error: one or more Markdown files failed to build." >&2
            exit 1
        fi
        echo "No Markdown files to build."
        exit 0
    fi

    ensure_tools

    if [[ ! -f "$PANDOC_ARGS_JSON" ]]; then
        echo "Error: pandoc-args.json not found." >&2
        exit 1
    fi

    local -a common_args=()
    while IFS= read -r arg; do
        common_args+=("$arg")
    done < <(jq -r '.pdf_args[]' "$PANDOC_ARGS_JSON")

    local timestamp log_file_name=""
    timestamp=$(date +"%Y-%m-%dT%H-%M-%S")
    if [[ "$log" == true ]]; then
        mkdir -p "$REPO_ROOT/log"
        log_file_name="pandoc_${report_name}_${timestamp}.log"
        echo "Log output enabled: log/$log_file_name"
    fi

    cd "$REPO_ROOT"

    local rel_dir rel_pdf output_dir container_work_dir defaults output_file output_dir_container pandoc_args pandoc_cmd inner_command start_time elapsed build_ec
    for input_file in "${buildable_files[@]}"; do
        rel_dir=$(dirname "$input_file")
        if [[ "$rel_dir" == "." ]]; then
            rel_dir=""
        fi
        rel_pdf="${input_file%.md}.pdf"
        output_dir="$PROJECTS_DIR/$report_name/output/$rel_dir"
        mkdir -p "$output_dir"

        container_work_dir="/data/projects/$report_name/$(source_dir_name "$source_dir")"
        defaults="../defaults.yml"
        output_file="../output/$rel_pdf"
        if [[ -z "$rel_dir" ]]; then
            output_dir_container="../output"
        else
            output_dir_container="../output/$rel_dir"
        fi

        pandoc_args=("${common_args[@]}")
        pandoc_args+=(--defaults "$defaults" "$input_file" -o "$output_file")
        if [[ "$log" == true ]]; then
            pandoc_args+=(--verbose)
        fi

        pandoc_cmd="pandoc"
        for arg in "${pandoc_args[@]}"; do
            pandoc_cmd+=" $(shell_quote "$arg")"
        done

        inner_command="cd $(shell_quote "$container_work_dir") && mkdir -p $(shell_quote "$output_dir_container") && $pandoc_cmd"
        start_time=$(date +%s)
        set +e
        if [[ "$log" == true ]]; then
            local log_path="$REPO_ROOT/log/$log_file_name"
            printf '%s\n' "--- Build started at $timestamp ($input_file) ---" >> "$log_path"
            "${DOCKER_COMPOSE_CMD[@]}" run --rm --entrypoint bash pandoc -lc "$inner_command" >> "$log_path" 2>&1
        else
            "${DOCKER_COMPOSE_CMD[@]}" run --rm --entrypoint bash pandoc -lc "$inner_command"
        fi
        build_ec=$?
        set -e
        elapsed=$(( $(date +%s) - start_time ))

        if [[ $build_ec -eq 0 && -f "$output_dir/$rel_pdf" ]]; then
            echo "$input_file -> $rel_pdf generated in ${elapsed}s"
        else
            echo "$input_file PDF generation failed." >&2
            had_failure=true
            if [[ "$log" == true ]]; then
                echo "See log/$log_file_name for details." >&2
            fi
        fi
    done

    if [[ "$log" == true ]]; then
        echo "Log saved to: log/$log_file_name"
    fi

    if [[ "$had_failure" == true ]]; then
        echo "Error: one or more Markdown files failed to build." >&2
        exit 1
    fi
}

main() {
    if [[ $# -eq 0 ]]; then
        usage
        exit 0
    fi

    case "$1" in
        -h|--help|help)
            usage
            ;;
        -V|--version|version)
            print_version
            ;;
        setup)
            shift
            setup_project "$@"
            ;;
        new)
            shift
            new_project "$@"
            ;;
        build)
            shift
            build_project "$@"
            ;;
        uninstall)
            echo "The Unix entrypoint does not uninstall itself." >&2
            echo "Remove the checkout or clean up Docker volumes manually if needed." >&2
            ;;
        *)
            echo "Error: unknown command '$1'" >&2
            usage >&2
            exit 1
            ;;
    esac
}

resolve_project_source_dir() {
    local report_name=$1
    local project_root="$PROJECTS_DIR/$report_name"
    if [[ -d "$project_root/content" ]]; then
        printf '%s' "$project_root/content"
    elif [[ -d "$project_root/src" ]]; then
        printf '%s' "$project_root/src"
    else
        printf '%s' "$project_root/content"
    fi
}

source_dir_name() {
    local source_dir=$1
    case "$(basename "$source_dir")" in
        src) printf 'src' ;;
        *) printf 'content' ;;
    esac
}

main "$@"
